rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly allow reads and writes to the appState document 'clarissa_jane_drt' 
    // to synchronize memory graphs and checklists securely.
    match /appState/{docId} {
      allow read, write: if docId == "clarissa_jane_drt";
    }
    
    // Safety Net: Deny all other read/write operations by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
