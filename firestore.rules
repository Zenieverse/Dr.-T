rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly allow reads and writes to all appState documents 
    // to synchronize memory graphs, eco playground state, and demographic reserves securely.
    match /appState/{docId} {
      allow read, write: if true;
    }

    // Allow read/write to anonymized R&D health research cases
    match /rndCases/{caseId} {
      allow read, write: if true;
    }

    // Allow read/write to real-time clinical case studies
    match /clinicalCases/{caseId} {
      allow read, write: if true;
    }

    // Allow read/write to real-time clinician feedback and patient user insights
    match /clinicianFeedback/{feedbackId} {
      allow read, write: if true;
    }

    // Allow read/write to real-time system metrics
    match /realtimeMetrics/{metricId} {
      allow read, write: if true;
    }

    // Allow read/write to Longevity Academy progress & certifications
    match /longevityProgress/{progressId} {
      allow read, write: if true;
    }

    // Allow read/write to Longevity Academy health journals & caregiver logs
    match /longevityJournals/{journalId} {
      allow read, write: if true;
    }

    // Allow read/write to Longevity Academy community forum posts
    match /longevityForum/{postId} {
      allow read, write: if true;
    }

    // Allow read/write to visitor headcount and live online statistics
    match /visitorStats/{docId} {
      allow read, write: if true;
    }

    // Allow read/write to detailed visitor session logs and usage analytics
    match /visitorLogs/{logId} {
      allow read, write: if true;
    }
    
    // Safety Net: Deny all other read/write operations by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
