# Twitch Developer Console credentials — server only
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must exactly match the registered Twitch OAuth redirect URI
TWITCH_REDIRECT_URI=https://YOUR_HOST/api/chatquest/auth/callback
# Generate a random value of at least 32 bytes; never commit the real value
CHATQUEST_SESSION_SECRET=
# Use a persistent writable path. Cloud Run container disk is ephemeral.
CHATQUEST_DATA_FILE=.data/chatquest-live.json

# Optional server-side Gemini assistance (quest ideas, review organization, completed quest summaries)
GEMINI_API_KEY=
CHATQUEST_GEMINI_MODEL=gemini-3.8-flash
