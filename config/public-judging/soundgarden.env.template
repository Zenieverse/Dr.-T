# ----------------------------------------------------------------------------
# SECTION A — RECOMMENDED ARCHITECTURE: MINIMAL STATIC WEBXR RELEASE
# Build command:
#   VITE_RUNTIME_ENV=public_judging DRT_RUNTIME_ENV=public_judging \
#   VITE_SYNTHETIC_ONLY=true DRT_SYNTHETIC_ONLY=true \
#   npm run build:soundgarden:public
# Output:
#   dist-soundgarden/ (zero backend, zero Firestore, zero Firebase SDK, zero secrets)
# ----------------------------------------------------------------------------
VITE_RUNTIME_ENV=public_judging
DRT_RUNTIME_ENV=public_judging
VITE_SYNTHETIC_ONLY=true
DRT_SYNTHETIC_ONLY=true

# Deployment-time operator placeholders (used ONLY by manual gcloud / firebase CLI,
# NEVER bundled into dist-soundgarden/ client code):
PUBLIC_JUDGING_GCP_PROJECT_ID=<DEDICATED_PUBLIC_JUDGING_GCP_PROJECT_ID>
PUBLIC_JUDGING_REGION=<DEDICATED_PUBLIC_JUDGING_REGION_E_G_US_CENTRAL1_OR_ASIA_SOUTHEAST1>
PUBLIC_JUDGING_HOSTING_SITE=<DEDICATED_FIREBASE_HOSTING_SITE_ID>
PUBLIC_JUDGING_CLOUD_RUN_SERVICE=<DEDICATED_STATIC_CLOUD_RUN_SERVICE_NAME>

