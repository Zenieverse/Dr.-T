# Environment variables for Dr. T Platform & Cinema Studio
GEMINI_API_KEY=
PARALLEL_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# ==========================================
# HEDERA COMMONS: TRUST & PROVENANCE LAYER
# ==========================================
# Network options: testnet (default), mainnet, previewnet
HEDERA_NETWORK=testnet
# Mode: mock (default safe dev sandbox), real (submits to live Hedera network)
HEDERA_MODE=mock
# Hedera Operator Account ID (e.g., 0.0.1234567)
HEDERA_ACCOUNT_ID=
# Hedera Operator Private Key (DER/HEX format - never committed to git)
HEDERA_PRIVATE_KEY=
# Hedera Consensus Service Topic ID for Dr. T Provenance
HEDERA_TOPIC_ID=0.0.5892147
# Hedera Mirror Node Base URL (default: https://testnet.mirrornode.hedera.com)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ==========================================
# LANTERN KEEPER: NEBIUS & NVIDIA NEMOTRON
# ==========================================
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct

# ==========================================
# OPEN-WEIGHT GEMMA / LOCAL INFERENCE
# ==========================================
GEMMA_API_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL=gemma2:2b

# ==========================================
# PAYPAL PAYFLOW AI: SANDBOX & PRODUCTION
# ==========================================
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ==========================================
# DR. T ENVIRONMENT ISOLATION & POPULATION HEALTH
# ==========================================
# Explicit environment: development | staging | production | public_judging
DRT_RUNTIME_ENV=development
# Mandatory outside development (production/staging/public_judging fail closed if unset or matching dev DB)
FIRESTORE_DATABASE_ID=
# Mandatory >=32-char HMAC secret via Secret Manager outside development (never commit real values)
POPULATION_GUEST_TOKEN_SECRET=
# Set true ONLY on dedicated public_judging deployments (blocks real patient workflows)
DRT_SYNTHETIC_ONLY=true
# Production keeps false so empty clinical databases do not auto-seed synthetic cohorts
DRT_SEED_DEMO_ON_EMPTY=false
# Safety flag reflecting Cloud Run max-instances=1 until state caching is fully stateless
CLOUD_RUN_MAX_INSTANCES=1
# Client Vite build overrides (staging / production / public_judging CI builds)
VITE_RUNTIME_ENV=development
VITE_FIREBASE_PROJECT_ID=
VITE_FIRESTORE_DATABASE_ID=

