# Environment variables for Dr. T Platform & Cinema Studio
GEMINI_API_KEY=
PARALLEL_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# ==========================================
# HEDERA COMMONS: TRUST & PROVENANCE LAYER
# ==========================================
# Network options: testnet (default), mainnet, previewnet
HEDERA_NETWORK=testnet
# Mode: mock (default safe dev sandbox), real (submits to live Hedera network)
HEDERA_MODE=mock
# Hedera Operator Account ID (e.g., 0.0.1234567)
HEDERA_ACCOUNT_ID=
# Hedera Operator Private Key (DER/HEX format - never committed to git)
HEDERA_PRIVATE_KEY=
# Hedera Consensus Service Topic ID for Dr. T Provenance
HEDERA_TOPIC_ID=0.0.5892147
# Hedera Mirror Node Base URL (default: https://testnet.mirrornode.hedera.com)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ==========================================
# LANTERN KEEPER: NEBIUS & NVIDIA NEMOTRON
# ==========================================
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct

# ==========================================
# OPEN-WEIGHT GEMMA / LOCAL INFERENCE
# ==========================================
GEMMA_API_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL=gemma2:2b
