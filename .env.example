# Environment variables for Dr. T Platform & Cinema Studio
GEMINI_API_KEY=
PARALLEL_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# ==========================================
# HEDERA COMMONS: TRUST & PROVENANCE LAYER
# ==========================================
# Network options: testnet (default), mainnet, previewnet
HEDERA_NETWORK=testnet
# Mode: mock (default safe dev sandbox), real (submits to live Hedera network)
HEDERA_MODE=mock
# Hedera Operator Account ID (e.g., 0.0.1234567)
HEDERA_ACCOUNT_ID=
# Hedera Operator Private Key (DER/HEX format - never committed to git)
HEDERA_PRIVATE_KEY=
# Hedera Consensus Service Topic ID for Dr. T Provenance
HEDERA_TOPIC_ID=0.0.5892147
# Hedera Mirror Node Base URL (default: https://testnet.mirrornode.hedera.com)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ==========================================
# LANTERN KEEPER: NEBIUS & NVIDIA NEMOTRON
# ==========================================
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct

# ==========================================
# OPEN-WEIGHT GEMMA / LOCAL INFERENCE
# ==========================================
GEMMA_API_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL=gemma2:2b

# ==========================================
# PAYPAL PAYFLOW AI: SANDBOX & PRODUCTION
# ==========================================
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ============================================================================
# DR. T ENVIRONMENT ISOLATION & POPULATION HEALTH
# ============================================================================
# Explicit server runtime environment: development | staging | production | public_judging
DRT_RUNTIME_ENV=development
# Explicit Cloud Run region for Admin API single-instance verification (e.g., asia-southeast1)
DRT_CLOUD_REGION=
# Mandatory outside development (production/staging/public_judging fail closed if unset, '(default)', or dev DB)
FIRESTORE_DATABASE_ID=
# Mandatory >=32-char HMAC secret via Secret Manager outside development (never commit real values)
POPULATION_GUEST_TOKEN_SECRET=
# Mandatory >=16-char server-side token required for X-DrT-Admin-Reset-Token on demo/load & demo/reset outside development
DRT_JUDGING_RESET_TOKEN=
# Set true ONLY on dedicated public_judging deployments (blocks real patient workflows & authenticated DB writes)
DRT_SYNTHETIC_ONLY=true
# Production/staging/public_judging keep false so empty databases do not auto-seed synthetic cohorts
DRT_SEED_DEMO_ON_EMPTY=false
# Self-declared informational scaling flag only (NOT trusted for fail-closed verification; Cloud Run Admin API is queried)
CLOUD_RUN_MAX_INSTANCES=1

# Client Vite build overrides (MANDATORY during vite build; zero silent fallback to firebase-applet-config.json outside development)
VITE_RUNTIME_ENV=development
VITE_FIREBASE_PROJECT_ID=
VITE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_SYNTHETIC_ONLY=true

