+    }
+    if (method === "tools/call") {
+      const toolName = params?.name;
+      const args = params?.arguments || {};
+      const gemini = getGemini();
+      if (toolName === "check_safety_escalation") {
+        const result = executeCheckSafetyEscalation(args);
+        return res.json({
