+`;
+      } else {
+        fallbackContent = `# ${params.projectName}
+
+> ${params.brief?.proposedSolution || 'AI-assisted project built for Devpost Learn AI Basics'}
+
+## 1. Overview
+${params.brief?.problemStatement || 'A modern solution designed for impact and clarity.'}
+
