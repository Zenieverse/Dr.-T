+  systolicBp: number;   // 70 - 260 mmHg
+  diastolicBp: number;  // 40 - 160 mmHg
+  heartRate?: number;   // 30 - 220 bpm
+  fastingGlucose?: number; // 40 - 500 mg/dL
+  symptoms?: string[];
+  region: 'US' | 'UK' | 'UAE' | 'Vietnam' | 'Global';
