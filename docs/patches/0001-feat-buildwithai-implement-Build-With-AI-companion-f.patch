+        const colRef = collection(db, 'buildwithai_projects');
+        const q = query(colRef, where('userId', '==', uid));
+        const snapshot = await getDocs(q);
+        const userProjects: BuildWithAiProject[] = [];
+        snapshot.forEach(docSnap => {
