+    userId: 'user_12345',
+    invoiceNumber: 'INV-2026-105',
+    business: { name: 'Lotus & Sea Catering', email: 'lotus@test.com' },
+    customer: { name: 'Celebration Host', email: 'host@test.com' },
+    items: [{
