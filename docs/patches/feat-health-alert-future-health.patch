+
+const reqWithPhone: HealthAlertIntakeData = { 
+  ...baseValidIntake, 
+  primaryConcern: 'Emergency call at 555-234-5678 immediately' 
+};
+const valPhone = validateHealthAlertRequest(reqWithPhone);
