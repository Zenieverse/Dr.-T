+
+const maleCohort: FutureHealthScreeningRequest = {
+  ...moderateIronCase,
+  demographics: { age: 30, gender: 'Male' }
+};
+const femaleCohort: FutureHealthScreeningRequest = {
+  ...moderateIronCase,
+  demographics: { age: 30, gender: 'Female' }
+};
