+  durationDays: 42,
+  severityScale: 6,
+  vitals: { bloodPressure: '114/72', restingHeartRate: 58 },
+  labs: { ferritin: 16, hba1c: 5.1 },
+  symptoms: ['Afternoon cognitive fog', 'Restless legs'],
+  medications: ['Multivitamin'],
+  allergies: ['Penicillin'],
+  consentGiven: true,
+  deIdentifiedConfirmed: true
